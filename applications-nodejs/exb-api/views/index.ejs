                var UseFreePlan = !Data.UseFreePlan || 'checked';

                var AccountStatusOptions = [ 'unpaid', 'free-plan', 'monetary-plan', 'expired', 'banned-account' ].map((AC) => {
                    if (Data.AccountStatus === AC) return `<option selected value="${AC}">${AC}</option>`;

                    return `<option value="${AC}">${AC}</option>`
                });

                var AccountPlanID = ['free', 'starter', 'base', 'pro', 'peerbtc', 'customized', ].map((AP) => {
                    if (Data.SubscriptionData.PlanID === AP) return `<option selected value="${AP}">${AP}</option>`;

                    return `<option value="${AP}">${AP}</option>`
                });

                var InsertHTML = `
                    <h2>Binance user data</h2>

                    <div class="row">
                        <div class="twelve columns">
                            <label class="ts">
                                <label for="AccountStatus">Account status</label>
                                <select class="u-full-width" id="AccountStatus">
                                    ${AccountStatusOptions.join("")}
                                </select>
                            </label>
                        </div>

                        <div class="twelve columns">
                            <label class="ts">
                                <label for="Username">Username</label>
                                <input class="u-full-width" type="text" placeholder="Username" id="Username" value="${Username}">
                            </label>
                        </div>

                        <div class="twelve columns">
                            <label class="ts">
                                <label for="Email">Email</label>
                                <input class="u-full-width" type="text" placeholder="Email" id="Email" value="${Data.Email}">
                            </label>
                        </div>

                        <div class="twelve columns">
                            <label class="ts">
                                <label for="PhoneNumber">Phone number</label>
                                <input class="u-full-width" type="text" placeholder="PhoneNumber" id="PhoneNumber" value="${Data.PhoneNumber}">
                            </label>
                        </div>

                        <div class="twelve columns">
                            <label class="ts">
                                <label for="AccountStatus">Account plan</label>
                                <select class="u-full-width" id="AccountPlan">
                                    ${AccountPlanID.join("")}
                                </select>
                            </label>
                        </div>

                        <div class="five columns">
                            <label class="ts">
                                <label for="AccountStatus">Plan start date</label>
                                <input class="u-full-width" type="text" onfocus="(this.type='date')" onblur="(this.type='text')" id="PlanStartDate" value="${Data.SubscriptionData.PlanStartDate}">
                            </label>
                        </div>

                        <div class="five columns">
                            <label class="ts">
                                <label for="AccountStatus">Plan end date</label>
                                <input class="u-full-width" type="text" onfocus="(this.type='date')" onblur="(this.type='text')" id="PlanEndDate" value="${Data.SubscriptionData.PlanEndDate}">
                            </label>
                        </div>
                    </div>

                    <label class="UseFreePlan">
                        <input ${UseFreePlan} id="UseFreePlan" type="checkbox">
                        <span class="label-body">free plan used?</span>
                    </label>

                    <button id="SaveNewUserData" onclick="SaveNewUserData('${Username}')" class="button-primary">Save</button>
                `;

                $("#UserDataModal").html(InsertHTML);

                $("#UserDataModal").modal({
                    fadeDuration: 100
                });
            }

            function SaveNewUserData (Username) {
                $('button#SaveNewUserData').text('Please wait ...')
                $('button#SaveNewUserData').prop('disabled', true);

                $.ajax({
                    method: 'POST',
                    url: '/system/userupdate',
                    data: {
                        Username: Username,
                        NewData: {
                            AccountStatus: $("select#AccountStatus").val(),
                            Username: $("#Username").val(),
                            Email: $("#Email").val(),
                            PhoneNumber: $("#PhoneNumber").val(),
                            SubscriptionData: {
                                TXID: 'free',
                                PlanID: $("#AccountPlan").val(),
                                PlanStartDate: new Date($("#PlanStartDate").val()),
                                PlanEndDate: new Date($("#PlanEndDate").val()),
                            },
                            UseFreePlan: $("#UseFreePlan").is(':checked')
                        }
                    },
                    success: () => {
                        $.modal.close();
                        
                        alert('User data updated!');

                        OpenTab(event, 'Users');
                    }
                });
            }
            
            function DeleteUser (Username) {
                var InsertHTML = `
                    <h2>Delete user confirm</h2>
                    <h5>Are you sure you want to delete the <strong><em>'${Username}'</em></strong>?</h5><br>
                    <button id="DeleteUserModal" style="background-color: #DF5E5E; border-color: #DF5E5E;margin-left: 10px;" onclick='DeleteUserReal("${Username}")' class="button-primary">Yes, Delete</button>
                `;

                $("#DeleteUserModal").html(InsertHTML);

                $("#DeleteUserModal").modal({
                    fadeDuration: 100
                });
            }

            function DeleteUserReal(Username) {
                $('button#DeleteUserModal').text('Please wait ...')
                $('button#DeleteUserModal').prop('disabled', true);

                $.ajax({
                    method: 'POST',
                    url: '/system/deleteuser',
                    data: {
                        Username: Username
                    },
                    success: () => {
                        $.modal.close();
                        
                        alert('User deleted!');

                        OpenTab(event, 'Users');
                    }
                });
            }
        </script>
    </body>
</html>