        <script>
            function AddUser () {
                var Username = $("input#UserUsername").val();
                var Email = $("input#UserEmail").val();
                var PhoneNumber = $("input#UserPhoneNumber").val();
                var BinanceAPIKEY = $("input#UserBinanceAPIKEY").val();
                var BinanceAPISECRET = $("input#UserBinanceAPISECRET").val();
                var UserPlan = $("select#UserPlan").val();

                $.ajax({
                    method: 'POST',
                    url: '/system/adduser',
                    data: {
                        Username: Username,
                        Email: Email,
                        PhoneNumber: PhoneNumber,
                        ExchangesData: {
                            Binance: {
                                APIKey: BinanceAPIKEY,
                                APISecret: BinanceAPISECRET
                            }
                        },
                        PlanID: UserPlan
                    },
                    success: (Data) => {
                        if (Data.status) {
                            alert('New user added.');
                        } else {
                            alert('Add user error, dup_username / dup_email / dup_phonenumber')
                        }                       
                    }
                });
            }

            function SLTypeListener () {
                var SLTypeListener = $("select#SLTypeListener").val();

                if (SLTypeListener === 'normal') {
                    $("div#stoploss-collapse").html(`
                        <div class="two columns">
                            <label for="NormalStoploss">Normal stoploss</label>
                            <input class="u-full-width" type="text" placeholder="45000" id="NormalStoploss">
                        </div>
                    `);
                } else if (SLTypeListener === 'manual') {
                    $("div#stoploss-collapse").html(`
                        <div class="two columns">
                            <label for="CandleInterval">Candle interval</label>
                            <select class="u-full-width" id="CandleInterval">
                                <option value="(1m)">1m</option>
                                <option value="(1h)">1h</option>
                                <option value="(4h)">4h</option>
                                <option value="daily (D)">daily</option>
                                <option value="weekly (W)">weekly</option>
                            </select>
                        </div>
                        <div class="two columns">
                            <label for="CandleSide">Candle side</label>
                            <select class="u-full-width" id="CandleSide">
                                <option value="above">Above</option>
                                <option value="below">Below</option>
                            </select>
                        </div>
                        <div class="two columns">
                            <label for="CandleNumber">Candle number</label>
                            <input class="u-full-width" type="text" placeholder="45000" id="CandleNumber">
                        </div>
                    `);
                } else {
                    $("div#stoploss-collapse").html('');
                }
            }
            
            function EXTypeListener () {
                var EXTypeListener = $("select#EXType").val();

                if (EXTypeListener === 'Binance Futures (LONG)' || EXTypeListener === 'Binance Futures (SHORT)') {
                    $('div#LeverageRange').html(`
                            <div class="two columns">
                                <label for="EPFrom">Leverage - from</label>
                                <input class="u-full-width" type="text" placeholder="2" id="LFrom">
                              </div>
                            <div class="two columns">
                              <label for="EPTo">Leverage  - to</label>
                              <input class="u-full-width" type="text" placeholder="5" id="LTo">
                            </div>
                    `);
                } else if (EXTypeListener === 'Binance Spot') {
                    $('div#LeverageRange').html(``);
                }
            }

            function SendForceSignal () {
                var EXType = $("select#EXType").val();

                var EPFrom = $("input#EPFrom").val();
                var EPTo = $("input#EPTo").val();

                var CFrom = $("input#CFrom").val();
                var CTo = $("input#CTo").val();
                
                var T1 = $("input#T1").val();
                var T2 = $("input#T2").val();
                var T3 = $("input#T3").val();
                var T4 = $("input#T4").val();
                var T5 = $("input#T5").val();
                var OT = $("input#OT").val();

                var Capital = $("input#CapitalNumber").val();

                var EXTypeListener = $("select#EXType").val();
                var CapitalText = '';
                if (EXTypeListener === 'Binance Futures (LONG)' || EXTypeListener === 'Binance Futures (SHORT)') {
                    var LFrom = $("input#LFrom").val();
                    var LTo = $("input#LTo").val();
                    var LeverageText = '';

                    if (LTo != '') LeverageText = `${LFrom}-${LTo}`;
                    else if (LTo === '') LeverageText = LFrom;

                    CapitalText = `${Capital}% CAPITAL (Isolated ${LeverageText}X)`;
                } else if (EXTypeListener === 'Binance Spot') {
                    CapitalText = `${Capital}% CAPITAL`;
                }

                var SLTypeListener = $("select#SLTypeListener").val();
                var StoplossText = '';
                if (SLTypeListener === 'normal') {
                    var SL = $("#NormalStoploss").val();

                    if (SL != '') StoplossText = `Normal Stop Loss: ${SL}`;
                } else if (SLTypeListener === 'manual') {
                    var CandleInterval = $("select#CandleInterval").val();
                    var CandleSide = $("select#CandleSide").val();
                    var CandleNumber = $("#CandleNumber").val();

                    if (CandleNumber != '') StoplossText = `Manual Stop Loss: \nClose ${CandleInterval} candle ${CandleSide} ${CandleNumber}`;
                }

                $('input#SendForceSignal').text('Please wait ...')
                $('input#SendForceSignal').prop('disabled', true);

                $.ajax({
                    method: 'POST',
                    url: '/system/sendforcesignal',
                    data: {
                        EXType: EXType,
                        EPFrom: EPFrom,
                        EPTo: EPTo,
                        CFrom: CFrom,
                        CTo: CTo,
                        T1: T1,
                        T2: T2,
                        T3: T3,
                        T4: T4,
                        T5: T5,
                        OT: OT,
                        CapitalText: CapitalText,
                        StoplossText: StoplossText
                    },
                    success: () => {
                        alert('Force signal sent to the force channel.');

                        OpenTab(event, 'ForceSignal');
                    }
                });
            }

            function ForceStopModal (ChatID) {
                var InsertHTML = `
                    <h2>Force stop signal confirm</h2>
                    <h5>Are you sure you want to forcestop the <strong><em>'${ChatID}'</em></strong>?</h5><br>
                    <button id="FroceStopReal" style="background-color: #DF5E5E; border-color: #DF5E5E;margin-left: 10px;" onclick='ForceStop("${ChatID}")' class="button-primary">Yes, Forcestop</button>
                `;

                $("#ForceStopModal").html(InsertHTML);

                $("#ForceStopModal").modal({
                    fadeDuration: 100
                });
            }

            function ForceStop (ChatID) {
                $('button#FroceStopReal').text('Please wait ...')
                $('button#FroceStopReal').prop('disabled', true);

                $.ajax({
                    url: '/system/forcestop',
                    method: 'POST',
                    data: {
                        ChatID: ChatID
                    },
                    success: (Data) => {
                        $.modal.close();

                        alert("Signal force stop running ...");

                        OpenTab(event, 'Signals');
                    }
                });
            }

            function ForceStopUserModal (Username, ChatID) {
                var InsertHTML = `
                    <h2>Delete signal user confirm</h2>
                    <h5>Are you sure you want to delete the <strong>'${ChatID}'</strong> <strong><em>'${Username}'</em></strong>?</h5><br>
                    <button id="DeleteSignalForUser" style="background-color: #DF5E5E; border-color: #DF5E5E;margin-left: 10px;" onclick='DeleteSignalForUser("${Username}", "${ChatID}")' class="button-primary">Yes, Delete</button>
                `;

                $("#ForceStopUserModal").html(InsertHTML);

                $("#ForceStopUserModal").modal({
                    fadeDuration: 100
                });
            }

            function DeleteSignalForUser (Username, ChatID) {
                $('button#DeleteSignalForUser').text('Please wait ...')
                $('button#DeleteSignalForUser').prop('disabled', true);

                $.ajax({
                    method: 'POST',
                    url: '/system/forcestop-user',
                    data: {
                        Username: Username,
                        ChatID: ChatID
                    },
                    success: () => {
                        $.modal.close();
                        
                        alert('Signal deleted!');

                        OpenTab(event, 'Users');
                    }
                });
            }

            function ShowUserSignals (Username, Signals) {
                var NewSignals = Signals.map((Signal) => {
                    if (Signal.PositionStatus === 'forcestop') {
                        var ForceStopBTN = `<h5 style="color: #DF5E5E">Stopped</h5>`;
                    } else{
                        var ForceStopBTN = `<button style="background-color: #DF5E5E; border-color: #DF5E5E;" onclick="ForceStopUserModal('${Username}', '${Signal.SignalChatID}')" id="${Signal.ChatID}" class="button-primary">Force stop</button>`;
                    }

                    return {
                        ExchangeType: Signal.ExchangeType.join(" ").toUpperCase(),
                        ChatID: Signal.SignalChatID,
                        Currency: Signal.Currency.join(" / ").toUpperCase(),
                        EnterPrice: Signal.EntryPrice,
                        SubmitedTargets: Signal.DoneTargets.length,
                        SignalStatus: Signal.PositionStatus,
                        ForceStop: ForceStopBTN,
                    }
                });

                $("#UserSignalsTable").DataTable({
                    data: NewSignals,
                    columns: [
                        { data: 'ExchangeType' },
                        { data: 'ChatID' },
                        { data: 'Currency' },
                        { data: 'EnterPrice' },
                        { data: 'SubmitedTargets' },
                        { data: 'SignalStatus' },
                        { data: 'ForceStop' }
                    ],
                    destroy: true,
                });

                $("#SignalsModal").modal({
                    fadeDuration: 100
                });
            }
            
